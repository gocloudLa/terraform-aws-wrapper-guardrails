locals {
  catalog = [
    "deny_leave_organization",
    "deny_root_user",
    "region_restriction",
    "protect_security_services",
    "protect_platform_roles",
    "deny_iam_users",
    "protect_s3_account_public_access",
    "protect_backup",
  ]

  # Guardrail key -> enabled (present and not null in var.guardrails).
  enabled = { for key in local.catalog : key => try(var.guardrails[key], null) != null }

  # Guardrail key -> exempted principal ARN patterns (guardrail override, else the policy-level list).
  exempt_principal_arns = {
    for key in local.catalog :
    key => try(var.guardrails[key].exempt_principal_arns, null) != null ? tolist(var.guardrails[key].exempt_principal_arns) : var.exempt_principal_arns
  }

  # Global / Region-agnostic actions left out of region_restriction (based on the AWS Control Tower Region deny control).
  region_restriction_not_actions = [
